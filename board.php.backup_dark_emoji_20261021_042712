<?php
if (session_status() === PHP_SESSION_NONE) { session_start(); }
require_once '/var/lib/site-live/members_lib.php';
$currentMember = site_current_member();
$isMember = is_array($currentMember);
$config = '/var/lib/site-live/board_config.php';
$dataFile = '/var/lib/site-live/board_posts.json';
$lockFile = '/var/lib/site-live/board_posts.lock';

if (!is_readable($config)) {
    http_response_code(500);
    exit('게시판 설정 파일을 읽을 수 없습니다.');
}
require $config;

$isAdmin = !empty($_SESSION['admin_logged_in']);

// 브라우저별 투표 식별자: 쿠키에는 토큰을, 데이터에는 해시만 저장
if (empty($_COOKIE['board_voter']) ||
    !preg_match('/^[a-f0-9]{64}$/', (string)$_COOKIE['board_voter'])) {
    $voterToken = bin2hex(random_bytes(32));
    setcookie('board_voter', $voterToken, [
        'expires' => time() + 31536000,
        'path' => '/',
        'secure' => !empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off',
        'httponly' => true,
        'samesite' => 'Lax'
    ]);
    $_COOKIE['board_voter'] = $voterToken;
} else {
    $voterToken = (string)$_COOKIE['board_voter'];
}
$voterKey = hash('sha256', $voterToken);

function e($v) {
    return htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}
function charCount($s) {
    return preg_match_all('/./us', $s, $m);
}
function loadPosts($file) {
    if (!is_file($file)) return [];
    $v = json_decode(file_get_contents($file), true);
    return is_array($v) ? $v : [];
}
function savePosts($file, $posts) {
    $json = json_encode(array_values($posts), JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
    if ($json === false || file_put_contents($file, $json, LOCK_EX) === false) {
        throw new RuntimeException('게시글 저장에 실패했습니다.');
    }
}
function adminName($isAdmin) {
    return $isAdmin
        ? '<span class="admin-name">👑 관리자</span>'
        : '';
}
function validCsrf() {
    return isset($_POST['csrf'], $_SESSION['board_csrf'])
        && hash_equals($_SESSION['board_csrf'], (string)$_POST['csrf']);
}
function redirectBoard($id = '') {
    header('Location: board.php' . ($id !== '' ? '?id=' . rawurlencode($id) : ''));
    exit;
}

function voteCounts($item) {
    $votes = is_array($item['votes'] ?? null) ? $item['votes'] : [];
    $likes = 0;
    $dislikes = 0;
    foreach ($votes as $v) {
        if ((int)$v === 1) $likes++;
        elseif ((int)$v === -1) $dislikes++;
    }
    return [$likes, $dislikes];
}

function renderVoteButtons($type, $postId, $commentId, $item, $voterKey) {
    $votes = is_array($item['votes'] ?? null) ? $item['votes'] : [];
    $mine = (int)($votes[$voterKey] ?? 0);
    [$likes, $dislikes] = voteCounts($item);
    $action = $type === 'comment' ? 'vote_comment' : 'vote_post';

    echo '<div class="vote-actions">';
    foreach ([1 => '👍 좋아요', -1 => '👎 싫어요'] as $value => $label) {
        $count = $value === 1 ? $likes : $dislikes;
        $active = $mine === $value ? ' active' : '';
        echo '<form method="post" class="vote-form">';
        echo '<input type="hidden" name="csrf" value="' . e($_SESSION['board_csrf']) . '">';
        echo '<input type="hidden" name="action" value="' . e($action) . '">';
        echo '<input type="hidden" name="post_id" value="' . e($postId) . '">';
        if ($type === 'comment') {
            echo '<input type="hidden" name="comment_id" value="' . e($commentId) . '">';
        }
        echo '<input type="hidden" name="vote" value="' . $value . '">';
        echo '<button class="vote-button' . $active . '" type="submit">' . $label . ' (' . $count . ')</button>';
        echo '</form>';
    }
    echo '</div>';
}

if (empty($_SESSION['board_csrf'])) {
    $_SESSION['board_csrf'] = bin2hex(random_bytes(32));
}

$message = '';
$action = (string)($_POST['action'] ?? '');

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!validCsrf()) {
        $message = '요청이 만료되었습니다. 새로고침 후 다시 시도해 주세요.';
    } else {
        $lock = @fopen($lockFile, 'c');
        if (!$lock) {
            $message = '게시판 파일을 열 수 없습니다. 서버 권한을 확인해 주세요.';
        } else {
            try {
                if (!flock($lock, LOCK_EX)) {
                    throw new RuntimeException('게시판 잠금에 실패했습니다.');
                }

                $posts = loadPosts($dataFile);
                $redirectId = '';

                if ($action === 'write') {
                    $name = trim((string)($_POST['name'] ?? ''));
                    $title = trim((string)($_POST['title'] ?? ''));
                    $content = trim((string)($_POST['content'] ?? ''));
                    $pw = (string)($_POST['password'] ?? '');

                    if ($isMember) { $name = (string)$currentMember['nickname']; $pw = ''; }
                    if (!$isAdmin && !$isMember && ($name === '' || $pw === '')) {
                        $message = '닉네임과 삭제 비밀번호를 입력해 주세요.';
                    } elseif ($title === '' || $content === '') {
                        $message = '제목과 내용을 입력해 주세요.';
                    } elseif (charCount($title) > 80 || charCount($content) > 5000
                        || (!$isAdmin && !$isMember && charCount($name) > 20) || strlen($pw) > 200) {
                        $message = '입력한 내용이 허용 길이를 초과했습니다.';
                    } else {
                        $imagePath = '';
                        $imagePaths = [];
                        $uploadDir = __DIR__ . '/board_uploads/';
                        $maxImageBytes = 50 * 1024 * 1024;
                        $allowedMimes = ['image/jpeg'=>'jpg','image/png'=>'png','image/gif'=>'gif','image/webp'=>'webp'];
                        $uploads = [];
                        if (isset($_FILES['board_images']) && is_array($_FILES['board_images']['name'] ?? null)) {
                            $count = count($_FILES['board_images']['name']);
                            if ($count > 10) throw new RuntimeException('이미지는 최대 10장까지 첨부할 수 있습니다.');
                            for ($i=0; $i<$count; $i++) $uploads[] = ['name'=>$_FILES['board_images']['name'][$i] ?? '', 'tmp_name'=>$_FILES['board_images']['tmp_name'][$i] ?? '', 'error'=>$_FILES['board_images']['error'][$i] ?? UPLOAD_ERR_NO_FILE, 'size'=>$_FILES['board_images']['size'][$i] ?? 0];
                        } elseif (isset($_FILES['board_image'])) {
                            $uploads[] = $_FILES['board_image'];
                        }
                        $uploads = array_values(array_filter($uploads, static fn($u) => (int)($u['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_NO_FILE));
                        if (count($uploads) > 10) throw new RuntimeException('이미지는 최대 10장까지 첨부할 수 있습니다.');
                        if ($uploads && !is_dir($uploadDir) && !mkdir($uploadDir, 0755, true)) throw new RuntimeException('이미지 폴더를 만들 수 없습니다.');
                        $finfo = new finfo(FILEINFO_MIME_TYPE);
                        foreach ($uploads as $upload) {
                            if ((int)$upload['error'] !== UPLOAD_ERR_OK) throw new RuntimeException('이미지 업로드 오류 코드: '.(int)$upload['error']);
                            $tmp=(string)$upload['tmp_name'];
                            $size=(int)$upload['size'];
                            if (!is_uploaded_file($tmp) || $size<1 || $size>$maxImageBytes) throw new RuntimeException('이미지는 장당 50MB 이하만 업로드할 수 있습니다.');
                            $mime=$finfo->file($tmp);
                            if (!isset($allowedMimes[$mime]) || @getimagesize($tmp)===false) throw new RuntimeException('JPG, PNG, GIF, WebP 이미지만 첨부할 수 있습니다.');
                            $filename=bin2hex(random_bytes(16)).'.'.$allowedMimes[$mime];
                            if (!move_uploaded_file($tmp,$uploadDir.$filename)) throw new RuntimeException('이미지 저장에 실패했습니다.');
                            $imagePaths[]='board_uploads/'.$filename;
                        }
                        $imagePath=$imagePaths[0] ?? '';

                        $id = bin2hex(random_bytes(8));
                        array_unshift($posts, [
                            'id' => $id,
                            'name' => $isAdmin ? '관리자' : $name,
                            'is_admin' => $isAdmin,
                            'member_id' => $isMember ? (string)$currentMember['id'] : '',
                            'member_role' => $isMember ? (string)($currentMember['role'] ?? 'member') : '',
                            'title' => $title,
                            'content' => $content,
                            'image' => $imagePath,
                            'images' => $imagePaths,
                            'password_hash' => ($isAdmin || $isMember) ? '' : password_hash($pw, PASSWORD_DEFAULT),
                            'date' => date('Y-m-d H:i'),
                            'views' => 0,
                            'comments' => []
                        ]);
                        savePosts($dataFile, $posts);
                        $redirectId = $id;
                    }
                } elseif ($action === 'comment') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $name = trim((string)($_POST['name'] ?? ''));
                    $content = trim((string)($_POST['content'] ?? ''));
                    $pw = (string)($_POST['password'] ?? '');

                    if ($isMember) { $name = (string)$currentMember['nickname']; $pw = ''; }
                    if ($content === '') {
                        $message = '댓글 내용을 입력해 주세요.';
                    } elseif (charCount($content) > 1000) {
                        $message = '댓글은 1000자 이내로 작성해 주세요.';
                    } elseif (!$isAdmin && !$isMember && ($name === '' || $pw === '')) {
                        $message = '닉네임과 댓글 삭제 비밀번호를 입력해 주세요.';
                    } elseif ((!$isAdmin && !$isMember && charCount($name) > 20) || strlen($pw) > 200) {
                        $message = '입력한 내용이 허용 길이를 초과했습니다.';
                    } else {
                        $found = false;
                        foreach ($posts as &$post) {
                            if (($post['id'] ?? '') !== $postId) continue;
                            $found = true;
                            if (!isset($post['comments']) || !is_array($post['comments'])) {
                                $post['comments'] = [];
                            }
                            $post['comments'][] = [
                                'id' => bin2hex(random_bytes(8)),
                                'name' => $isAdmin ? '관리자' : $name,
                                'is_admin' => $isAdmin,
                                'member_id' => $isMember ? (string)$currentMember['id'] : '',
                                'member_role' => $isMember ? (string)($currentMember['role'] ?? 'member') : '',
                                'content' => $content,
                                'password_hash' => ($isAdmin || $isMember) ? '' : password_hash($pw, PASSWORD_DEFAULT),
                                'date' => date('Y-m-d H:i')
                            ];
                            break;
                        }
                        unset($post);

                        if ($found) {
                            savePosts($dataFile, $posts);
                            $redirectId = $postId;
                        } else {
                            $message = '게시글을 찾을 수 없습니다.';
                        }
                    }
                } elseif ($action === 'vote_post' || $action === 'vote_comment') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $commentId = (string)($_POST['comment_id'] ?? '');
                    $vote = (int)($_POST['vote'] ?? 0);

                    if (!in_array($vote, [1, -1], true)) {
                        $message = '올바르지 않은 투표입니다.';
                    } else {
                        $found = false;
                        foreach ($posts as &$post) {
                            if (($post['id'] ?? '') !== $postId) continue;

                            if ($action === 'vote_post') {
                                $found = true;
                                if (!isset($post['votes']) || !is_array($post['votes'])) {
                                    $post['votes'] = [];
                                }
                                if ((int)($post['votes'][$voterKey] ?? 0) === $vote) {
                                    unset($post['votes'][$voterKey]);
                                } else {
                                    $post['votes'][$voterKey] = $vote;
                                }
                            } else {
                                foreach (($post['comments'] ?? []) as &$comment) {
                                    if (($comment['id'] ?? '') !== $commentId) continue;
                                    $found = true;
                                    if (!isset($comment['votes']) || !is_array($comment['votes'])) {
                                        $comment['votes'] = [];
                                    }
                                    if ((int)($comment['votes'][$voterKey] ?? 0) === $vote) {
                                        unset($comment['votes'][$voterKey]);
                                    } else {
                                        $comment['votes'][$voterKey] = $vote;
                                    }
                                    break;
                                }
                                unset($comment);
                            }
                            break;
                        }
                        unset($post);

                        if ($found) {
                            savePosts($dataFile, $posts);
                            $redirectId = $postId;
                        } else {
                            $message = '게시글 또는 댓글을 찾을 수 없습니다.';
                        }
                    }
                } elseif ($action === 'delete_post') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $pw = (string)($_POST['password'] ?? '');
                    $found = false;

                    foreach ($posts as $i => $post) {
                        if (($post['id'] ?? '') !== $postId) continue;
                        $found = true;
                        $isMemberOwner = $isMember && !empty($post['member_id']) && hash_equals((string)$post['member_id'], (string)$currentMember['id']);
                        $isOwner = !empty($post['password_hash']) && password_verify($pw, $post['password_hash']);
                        $isOwner = $isOwner || $isMemberOwner;
                        $isMaster = hash_equals((string)BOARD_MASTER_PASSWORD, $pw);

                        if ($isAdmin || $isOwner || $isMaster) {
                            array_splice($posts, $i, 1);
                            savePosts($dataFile, $posts);
                            $redirectId = '';
                        } else {
                            $message = '삭제 권한이 없거나 비밀번호가 올바르지 않습니다.';
                            $redirectId = $postId;
                        }
                        break;
                    }
                    if (!$found) $message = '게시글을 찾을 수 없습니다.';
                } elseif ($action === 'delete_comment') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $commentId = (string)($_POST['comment_id'] ?? '');
                    $pw = (string)($_POST['password'] ?? '');
                    $foundPost = false;
                    $foundComment = false;

                    foreach ($posts as &$post) {
                        if (($post['id'] ?? '') !== $postId) continue;
                        $foundPost = true;
                        $comments = $post['comments'] ?? [];
                        foreach ($comments as $i => $comment) {
                            if (($comment['id'] ?? '') !== $commentId) continue;
                            $foundComment = true;
                            $isMemberOwner = $isMember && !empty($comment['member_id']) && hash_equals((string)$comment['member_id'], (string)$currentMember['id']);
                            $isOwner = !empty($comment['password_hash']) && password_verify($pw, $comment['password_hash']);
                            $isOwner = $isOwner || $isMemberOwner;
                            $isMaster = hash_equals((string)BOARD_MASTER_PASSWORD, $pw);

                            if ($isAdmin || $isOwner || $isMaster) {
                                array_splice($comments, $i, 1);
                                $post['comments'] = $comments;
                            } else {
                                $message = '삭제 권한이 없거나 비밀번호가 올바르지 않습니다.';
                            }
                            break;
                        }
                        break;
                    }
                    unset($post);

                    if ($foundPost && $foundComment && $message === '') {
                        savePosts($dataFile, $posts);
                    } elseif (!$foundPost || !$foundComment) {
                        $message = '게시글 또는 댓글을 찾을 수 없습니다.';
                    }
                    $redirectId = $postId;
                }

                flock($lock, LOCK_UN);
                fclose($lock);
                $lock = null;

                if ($redirectId !== '') redirectBoard($redirectId);
                if ($action === 'delete_post' && $message === '') redirectBoard();
                if ($action === 'delete_comment' && $message === '') redirectBoard($postId);
            } catch (Throwable $ex) {
                if (is_resource($lock)) {
                    @flock($lock, LOCK_UN);
                    @fclose($lock);
                }
                error_log('Board error: ' . $ex->getMessage());
                $message = '처리 중 오류가 발생했습니다. 서버 로그와 권한을 확인해 주세요.';
            }
        }
    }
}

$posts = loadPosts($dataFile);
$id = (string)($_GET['id'] ?? '');
$selected = null;

if ($id !== '') {
    foreach ($posts as &$post) {
        if (($post['id'] ?? '') !== $id) continue;
        $selected = $post;

        if (empty($_SESSION['board_viewed'][$id])) {
            $viewLock = @fopen($lockFile, 'c');
            if ($viewLock) {
                flock($viewLock, LOCK_EX);
                $latest = loadPosts($dataFile);
                foreach ($latest as &$item) {
                    if (($item['id'] ?? '') === $id) {
                        $item['views'] = (int)($item['views'] ?? 0) + 1;
                        $selected = $item;
                        break;
                    }
                }
                unset($item);
                savePosts($dataFile, $latest);
                flock($viewLock, LOCK_UN);
                fclose($viewLock);
                $_SESSION['board_viewed'][$id] = true;
                $posts = $latest;
            }
        }
        break;
    }
    unset($post);
}

function renderAuthor($name, $isAdmin, $memberId = '', $memberRole = '') {
    if ($isAdmin) {
        echo '<span class="admin-name">👑 관리자</span>';
        return;
    }
    $name = $name !== '' ? $name : '익명';
    if ($memberId !== '') {
        if ($memberRole === 'operator') {
            echo '<span style="color:#60a5fa;font-weight:800">🔷 ' . e($name) . '</span>';
        } elseif ($memberRole === 'special_guest') {
            echo '<span style="color:#facc15;font-weight:800">🍀 ' . e($name) . '</span>';
        } else {
            echo '<span style="color:#60a5fa;font-weight:700">💠 ' . e($name) . '</span>';
        }
    } else {
        echo e($name);
    }
}
