<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);

session_start();
$data_file = "dark_path_data.txt";
$upload_dir = "uploads/";

if (!is_dir($upload_dir)) {
    mkdir($upload_dir, 0775, true);
    chmod($upload_dir, 0775);
}

$master_password = "master1234";

if (isset($_GET["exit_secret"])) {
    unset($_SESSION["dark_path_auth"]);
    header("Location: index.html");
    exit;
}

if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["action"]) && $_POST["action"] === "login") {
    $input_name = trim($_POST["dev_login_answer"] ?? "");
    if ($input_name === "eltmzhemgmswptjq") {
        $_SESSION["dark_path_auth"] = true;
        header("Location: " . $_SERVER["PHP_SELF"]);
        exit;
    } else {
        $login_error = "인증 실패: 접근 권한이 없습니다.";
    }
}

if (!isset($_SESSION["dark_path_auth"]) || $_SESSION["dark_path_auth"] !== true):
?>
