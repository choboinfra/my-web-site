        a { color: #90caf9; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .write-box { background: #1e1e1e; padding: 15px; border-radius: 4px; border: 1px solid #333; margin-bottom: 20px; }
        .form-group { margin-bottom: 10px; }
        label { display: block; font-size: 0.85em; margin-bottom: 4px; color: #888; }
        input, textarea { width: 100%; padding: 8px; box-sizing: border-box; background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 3px; }
        button.submit-btn { background: #d32f2f; color: #fff; font-weight: bold; border: none; padding: 10px 20px; cursor: pointer; border-radius: 3px; width: 100%; }
        button.submit-btn:hover { background: #e53935; }
        
        .post { background: #1a1a1a; border: 1px solid #2a2a2a; padding: 15px; margin-bottom: 15px; border-radius: 4px; overflow: hidden; word-break: break-word; }
        .post-header { display: flex; justify-content: space-between; font-weight: bold; color: #ffb74d; border-bottom: 1px solid #262626; padding-bottom: 8px; margin-bottom: 10px; }
        .post-date { font-size: 0.8em; color: #666; font-weight: normal; }
        .post-content { white-space: pre-wrap; margin-bottom: 15px; line-height: 1.4; word-break: break-word; }
        
        .attachment-box { background: #111; padding: 12px; border-radius: 4px; border: 1px dashed #333; margin-top: 10px; overflow: hidden; }
        .attachment-info { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
        .download-btn { background: #1976d2; color: #fff; padding: 6px 12px; border-radius: 4px; font-size: 0.85em; text-decoration: none; font-weight: bold; display: inline-block; }
        .download-btn:hover { background: #2196f3; }
        
        /* 이미지가 박스를 절대 뚫고 나가지 못하도록 강제 제한 */
        .attachment-box img { 
            max-width: 100% !important; 
            width: auto !important;
            height: auto !important; 
            max-height: 400px; 
            object-fit: contain; 
            border-radius: 4px; 
            display: block; 
            margin: 10px auto 0 auto; 
        }
        .attachment-box video, .attachment-box audio {
            max-width: 100% !important;
            width: 100%;
            margin-top: 10px;
            border-radius: 4px;
        }

        .del-form { display: inline-block; float: right; }
        .del-form input { width: 85px; padding: 2px; font-size: 0.75em; display: inline-block; }
        .del-form button { background: #444; color: #fff; border: none; padding: 2px 6px; font-size: 0.75em; cursor: pointer; border-radius: 2px; }
        .del-form button:hover { background: #d32f2f; }
    </style>
</head>
<body>
<div class="container">
    <h2>
        <span> 어둠의 경로 (Secret Archive)</span>
        <a href="?exit_secret=1" style="font-size: 0.6em; color: #ff5252;">[잠그고 나가기]</a>
    </h2>
    <p style="font-size: 0.85em; color: #666;"><a href="?exit_secret=1">← 메인으로 돌아가기</a></p>
    
    <div class="write-box">
        <form method="POST" enctype="multipart/form-data">
            <input type="hidden" name="action" value="write">
            <div style="display: flex; gap: 10px;" class="form-group">
                <div style="flex: 1;">
                    <label>닉네임</label>
                    <input type="text" name="name" required placeholder="익명">
                </div>
                <div style="flex: 1;">
