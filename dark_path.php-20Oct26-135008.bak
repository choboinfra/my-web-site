    exit;
endif;

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $action = $_POST["action"] ?? "";
    
    if ($action === "write") {
        $name = trim($_POST["name"] ?? "");
        $password = trim($_POST["password"] ?? "");
        $content = trim($_POST["content"] ?? "");
        $file_url = "";
        $file_name = "";

        if (isset($_FILES["upload_file"]) && $_FILES["upload_file"]["error"] === UPLOAD_ERR_OK) {
            $tmp_name = $_FILES["upload_file"]["tmp_name"];
            $orig_name = basename($_FILES["upload_file"]["name"]);
            $ext = pathinfo($orig_name, PATHINFO_EXTENSION);
            $safe_filename = time() . "_" . mt_rand(100, 999) . ($ext ? ("." . $ext) : "");
            $destination = $upload_dir . $safe_filename;
            
            if (move_uploaded_file($tmp_name, $destination)) {
                chmod($destination, 0664);
                $file_url = $destination;
                $file_name = htmlspecialchars($orig_name);
            }
        }

        if (!empty($name) && !empty($password) && (!empty($content) || !empty($file_url))) {
            $entries = file_exists($data_file) ? json_decode(file_get_contents($data_file), true) : [];
            if (!is_array($entries)) $entries = [];
            
            $new_entry = [
                "id" => time() . mt_rand(10, 99),
                "name" => htmlspecialchars($name),
                "password" => $password,
                "content" => htmlspecialchars($content),
                "file_url" => $file_url,
                "file_name" => $file_name,
                "date" => date("Y-m-d H:i:s")
            ];
            array_unshift($entries, $new_entry);
            file_put_contents($data_file, json_encode($entries, JSON_UNESCAPED_UNICODE));
        }
        header("Location: " . $_SERVER["PHP_SELF"]);
        exit;
    }
    
    if ($action === "delete") {
        $target_id = $_POST["target_id"] ?? "";
        $del_pw = trim($_POST["password"] ?? "");
        
        if (file_exists($data_file)) {
            $entries = json_decode(file_get_contents($data_file), true);
            if (is_array($entries)) {
                foreach ($entries as $idx => $entry) {
                    if ($entry["id"] == $target_id && ($entry["password"] === $del_pw || $del_pw === $master_password)) {
                        if (!empty($entry["file_url"]) && file_exists($entry["file_url"])) {
                            unlink($entry["file_url"]);
                        }
                        unset($entries[$idx]);
                    }
                }
                $entries = array_values($entries);
                file_put_contents($data_file, json_encode($entries, JSON_UNESCAPED_UNICODE));
            }
        }
        header("Location: " . $_SERVER["PHP_SELF"]);
        exit;
    }
}

$entries = file_exists($data_file) ? json_decode(file_get_contents($data_file), true) : [];
if (!is_array($entries)) $entries = [];
?>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>어둠의 경로</title>
    <style>
        body { font-family: sans-serif; background: #0f0f0f; color: #d0d0d0; margin: 0; padding: 20px; box-sizing: border-box; }
