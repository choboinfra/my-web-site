            </div>
            <button type="submit" class="submit-btn">업로드 등록</button>
        </form>
    </div>

    <div class="post-list">
        <?php if (empty($entries)): ?>
            <p style="text-align: center; color: #555; padding: 30px;">기록된 자료가 없습니다.</p>
        <?php else: ?>
            <?php foreach ($entries as $entry): ?>
                <div class="post">
                    <div class="post-header">
                        <span><?= $entry["name"] ?></span>
                        <div>
                            <span class="post-date"><?= $entry["date"] ?></span>
                            <form method="POST" class="del-form" onsubmit="return confirm('정말 삭제하시겠습니까?');">
                                <input type="hidden" name="action" value="delete">
                                <input type="hidden" name="target_id" value="<?= $entry["id"] ?>">
                                <input type="password" name="password" placeholder="비번/마스터" required>
                                <button type="submit">삭제</button>
                            </form>
                        </div>
                    </div>
                    
                    <?php if (!empty($entry["content"])): ?>
                        <div class="post-content"><?= $entry["content"] ?></div>
                    <?php endif; ?>
                    
                    <?php if (!empty($entry["file_url"])): ?>
                        <div class="attachment-box">
                            <div class="attachment-info">
                                <span style="font-size: 0.9em; color: #ccc; word-break: break-all;">첨부파일: <b><?= $entry["file_name"] ?></b></span>
                                <a href="<?= $entry["file_url"] ?>" class="download-btn" download>다운로드</a>
                            </div>
                            <?php 
                                $ext = strtolower(pathinfo($entry["file_url"], PATHINFO_EXTENSION));
                                if (in_array($ext, ["jpg", "jpeg", "png", "gif", "webp"])) {
                                    echo "<img src=\"" . $entry["file_url"] . "\" alt=\"uploaded image\">";
                                } elseif (in_array($ext, ["mp4", "webm", "ogg"])) {
                                    echo "<video controls><source src=\"" . $entry["file_url"] . "\"></video>";
                                } elseif (in_array($ext, ["mp3", "wav", "ogg"])) {
                                    echo "<audio controls><source src=\"" . $entry["file_url"] . "\"></audio>";
                                }
                            ?>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>
    </div>
</div>
</body>
</html>