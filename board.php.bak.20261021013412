<?php
session_start();

$config = '/var/lib/site-live/board_config.php';
$dataFile = '/var/lib/site-live/board_posts.json';
$lockFile = '/var/lib/site-live/board_posts.lock';

if (!is_readable($config)) {
    http_response_code(500);
    exit('게시판 설정 파일을 읽을 수 없습니다. 관리자에게 문의하세요.');
}
require $config;

function e($v) {
    return htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}
function charCount($s) {
    return preg_match_all('/./us', $s, $m);
}
function loadPosts($file) {
    if (!is_file($file)) return [];
    $data = json_decode(file_get_contents($file), true);
    return is_array($data) ? $data : [];
}
function savePosts($file, $posts) {
    $json = json_encode(array_values($posts), JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
    if ($json === false || file_put_contents($file, $json, LOCK_EX) === false) {
        throw new RuntimeException('저장에 실패했습니다.');
    }
}
function csrfCheck() {
    return isset($_POST['csrf'], $_SESSION['board_csrf'])
        && hash_equals($_SESSION['board_csrf'], (string)$_POST['csrf']);
}

if (empty($_SESSION['board_csrf'])) {
    $_SESSION['board_csrf'] = bin2hex(random_bytes(32));
}
$message = '';
$action = $_POST['action'] ?? '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!csrfCheck()) {
        $message = '요청이 만료되었습니다. 새로고침 후 다시 시도해 주세요.';
    } else {
        try {
            $lock = fopen($lockFile, 'c');
            if (!$lock) throw new RuntimeException('게시판 잠금 파일을 열 수 없습니다.');
            flock($lock, LOCK_EX);
            $posts = loadPosts($dataFile);

            if ($action === 'write') {
                $name = trim((string)($_POST['name'] ?? ''));
                $title = trim((string)($_POST['title'] ?? ''));
                $content = trim((string)($_POST['content'] ?? ''));
                $pw = (string)($_POST['password'] ?? '');

                if ($name === '' || $title === '' || $content === '' || $pw === '') {
                    $message = '닉네임, 제목, 내용, 삭제 비밀번호를 모두 입력해 주세요.';
                } elseif (charCount($name) > 20 || charCount($title) > 80 || charCount($content) > 5000) {
                    $message = '닉네임은 20자, 제목은 80자, 내용은 5000자 이내로 작성해 주세요.';
                } elseif (strlen($pw) > 200) {
                    $message = '비밀번호가 너무 깁니다.';
                } else {
                    array_unshift($posts, [
                        'id' => bin2hex(random_bytes(8)),
                        'name' => $name,
                        'title' => $title,
                        'content' => $content,
                        'password_hash' => password_hash($pw, PASSWORD_DEFAULT),
                        'date' => date('Y-m-d H:i'),
                        'views' => 0
                    ]);
                    savePosts($dataFile, $posts);
                    $newId = $posts[0]['id'];
                    flock($lock, LOCK_UN);
                    fclose($lock);
                    header('Location: board.php?id=' . rawurlencode($newId));
                    exit;
                }
            } elseif ($action === 'delete') {
                $id = (string)($_POST['id'] ?? '');
                $pw = (string)($_POST['password'] ?? '');
                $found = false;

                foreach ($posts as $i => $post) {
                    if (($post['id'] ?? '') !== $id) continue;
                    $found = true;
                    $isMaster = hash_equals((string)BOARD_MASTER_PASSWORD, $pw);
                    $isAuthor = isset($post['password_hash'])
                        && password_verify($pw, $post['password_hash']);

                    if ($isMaster || $isAuthor) {
                        array_splice($posts, $i, 1);
                        savePosts($dataFile, $posts);
                        $message = '게시글을 삭제했습니다.';
                    } else {
                        $message = '삭제 비밀번호가 올바르지 않습니다.';
                    }
                    break;
                }
                if (!$found) $message = '게시글을 찾을 수 없습니다.';
            }
            flock($lock, LOCK_UN);
            fclose($lock);
        } catch (Throwable $ex) {
            if (isset($lock) && is_resource($lock)) {
                @flock($lock, LOCK_UN);
                @fclose($lock);
            }
            error_log('Board error: ' . $ex->getMessage());
            $message = '처리 중 오류가 발생했습니다. 서버 권한을 확인해 주세요.';
        }
    }
}

$posts = loadPosts($dataFile);
$id = (string)($_GET['id'] ?? '');
$selected = null;

if ($id !== '') {
    foreach ($posts as $i => $post) {
        if (($post['id'] ?? '') !== $id) continue;
        $selected = $post;
        if (empty($_SESSION['board_viewed'][$id])) {
            $lock = @fopen($lockFile, 'c');
            if ($lock) {
                flock($lock, LOCK_EX);
                $latest = loadPosts($dataFile);
                foreach ($latest as &$item) {
                    if (($item['id'] ?? '') === $id) {
                        $item['views'] = (int)($item['views'] ?? 0) + 1;
                        $selected = $item;
                        break;
                    }
                }
                unset($item);
                savePosts($dataFile, $latest);
                flock($lock, LOCK_UN);
                fclose($lock);
                $_SESSION['board_viewed'][$id] = true;
                $posts = $latest;
            }
        }
        break;
    }
}
