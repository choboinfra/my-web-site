<?php
$file = 'guestbook_data.txt';

// 데이터 처리 (글 작성, 댓글 작성, 삭제)
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    
    // 1. 새 글 작성
    if ($action === 'write') {
        $dev_answer = trim($_POST['dev_answer'] ?? '');
        
        // [설정] 개발자 이름 암호: '조승훈' (공백 제거 후 비교)
        if ($dev_answer !== '조승훈') {
            echo "<script>alert('개발자 이름 정답이 틀렸습니다! 글을 쓸 수 없습니다.'); history.back();</script>";
            exit;
        }

        $name = trim($_POST['name']);
        $password = trim($_POST['password']);
        $content = trim($_POST['content']);
        
        if (!empty($name) && !empty($password) && !empty($content)) {
            $entries = file_exists($file) ? json_decode(file_get_contents($file), true) : [];
            $new_entry = [
                'id' => time(),
                'type' => 'post',
                'name' => htmlspecialchars($name),
                'password' => $password,
                'content' => htmlspecialchars($content),
                'date' => date('Y-m-d H:i:s'),
                'comments' => []
            ];
            array_unshift($entries, $new_entry); // 최신글이 위로
            file_put_contents($file, json_encode($entries, JSON_UNESCAPED_UNICODE));
        }
        header('Location: ' . $_SERVER['PHP_SELF']);
        exit;
    }
    
    // 2. 댓글 작성
    if ($action === 'comment') {
        $post_id = $_POST['post_id'];
        $c_name = trim($_POST['c_name']);
        $c_pw = trim($_POST['c_pw']);
        $c_content = trim($_POST['c_content']);
        
        if (!empty($c_name) && !empty($c_pw) && !empty($c_content) && file_exists($file)) {
            $entries = json_decode(file_get_contents($file), true);
            foreach ($entries as &$entry) {
                if ($entry['id'] == $post_id) {
                    $entry['comments'][] = [
                        'c_id' => time() . mt_rand(10,99),
                        'c_name' => htmlspecialchars($c_name),
                        'c_pw' => $c_pw,
                        'c_content' => htmlspecialchars($c_content),
                        'date' => date('Y-m-d H:i:s')
                    ];
                    break;
                }
            }
            file_put_contents($file, json_encode($entries, JSON_UNESCAPED_UNICODE));
        }
        header('Location: ' . $_SERVER['PHP_SELF']);
        exit;
    }

    // 3. 삭제 (글 또는 댓글)
    if ($action === 'delete') {
        $target_id = $_POST['target_id'];
        $del_pw = $_POST['password'];
        $is_comment = isset($_POST['is_comment']) ? true : false;
        
        if (file_exists($file)) {
            $entries = json_decode(file_get_contents($file), true);
            if ($is_comment) {
                // 댓글 삭제
                foreach ($entries as &$entry) {
                    foreach ($entry['comments'] as $idx => $comm) {
                        if ($comm['c_id'] == $target_id && $comm['c_pw'] === $del_pw) {
                            unset($entry['comments'][$idx]);
                            $entry['comments'] = array_values($entry['comments']);
                        }
                    }
                }
            } else {
                // 게시글 삭제
                $entries = array_filter($entries, function($entry) use ($target_id, $del_pw) {
                    if ($entry['id'] == $target_id) {
                        return $entry['password'] !== $del_pw; // 비번 같으면 제외(삭제)
                    }
                    return true;
                });
                $entries = array_values($entries);
            }
            file_put_contents($file, json_encode($entries, JSON_UNESCAPED_UNICODE));
        }
        header('Location: ' . $_SERVER['PHP_SELF']);
        exit;
    }
}

$entries = file_exists($file) ? json_decode(file_get_contents($file), true) : [];
?>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>방명록</title>
