                            <?php foreach ($entry['comments'] as $comm): ?>
                                <div class="comment-item">
                                    <div>
                                        <strong style="color: #90caf9;"><?= $comm['c_name'] ?></strong>: <?= $comm['c_content'] ?> 
                                        <span style="font-size: 0.75em; color: #666;">(<?= $comm['date'] ?>)</span>
                                    </div>
                                    <!-- 댓글 삭제 폼 -->
                                    <form method="POST" style="display:inline;" onsubmit="return confirm('댓글을 삭제하시겠습니까?');">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="target_id" value="<?= $comm['c_id'] ?>">
