                                        <input type="password" name="password" placeholder="비번" style="width: 50px; font-size: 0.75em; background:#121212; color:#fff; border:1px solid #444;" required>
                                        <button type="submit" style="background:#b71c1c; color:#fff; border:none; padding:2px 5px; font-size:0.75em; cursor:pointer;">삭제</button>
                                    </form>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                        
                        <!-- 댓글 작성 폼 -->
