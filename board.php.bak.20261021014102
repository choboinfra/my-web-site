<?php
session_start();

$config = '/var/lib/site-live/board_config.php';
$dataFile = '/var/lib/site-live/board_posts.json';
$lockFile = '/var/lib/site-live/board_posts.lock';

if (!is_readable($config)) {
    http_response_code(500);
    exit('게시판 설정 파일을 읽을 수 없습니다.');
}
require $config;

$isAdmin = !empty($_SESSION['admin_logged_in']);

function e($v) {
    return htmlspecialchars((string)$v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}
function charCount($s) {
    return preg_match_all('/./us', $s, $m);
}
function loadPosts($file) {
    if (!is_file($file)) return [];
    $v = json_decode(file_get_contents($file), true);
    return is_array($v) ? $v : [];
}
function savePosts($file, $posts) {
    $json = json_encode(array_values($posts), JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
    if ($json === false || file_put_contents($file, $json, LOCK_EX) === false) {
        throw new RuntimeException('게시글 저장에 실패했습니다.');
    }
}
function adminName($isAdmin) {
    return $isAdmin
        ? '<span class="admin-name">👑 관리자</span>'
        : '';
}
function validCsrf() {
    return isset($_POST['csrf'], $_SESSION['board_csrf'])
        && hash_equals($_SESSION['board_csrf'], (string)$_POST['csrf']);
}
function redirectBoard($id = '') {
    header('Location: board.php' . ($id !== '' ? '?id=' . rawurlencode($id) : ''));
    exit;
}

if (empty($_SESSION['board_csrf'])) {
    $_SESSION['board_csrf'] = bin2hex(random_bytes(32));
}

$message = '';
$action = (string)($_POST['action'] ?? '');

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!validCsrf()) {
        $message = '요청이 만료되었습니다. 새로고침 후 다시 시도해 주세요.';
    } else {
        $lock = @fopen($lockFile, 'c');
        if (!$lock) {
            $message = '게시판 파일을 열 수 없습니다. 서버 권한을 확인해 주세요.';
        } else {
            try {
                if (!flock($lock, LOCK_EX)) {
                    throw new RuntimeException('게시판 잠금에 실패했습니다.');
                }

                $posts = loadPosts($dataFile);
                $redirectId = '';

                if ($action === 'write') {
                    $name = trim((string)($_POST['name'] ?? ''));
                    $title = trim((string)($_POST['title'] ?? ''));
                    $content = trim((string)($_POST['content'] ?? ''));
                    $pw = (string)($_POST['password'] ?? '');

                    if (!$isAdmin && ($name === '' || $pw === '')) {
                        $message = '닉네임과 삭제 비밀번호를 입력해 주세요.';
                    } elseif ($title === '' || $content === '') {
                        $message = '제목과 내용을 입력해 주세요.';
                    } elseif (charCount($title) > 80 || charCount($content) > 5000
                        || (!$isAdmin && charCount($name) > 20) || strlen($pw) > 200) {
                        $message = '입력한 내용이 허용 길이를 초과했습니다.';
                    } else {
                        $id = bin2hex(random_bytes(8));
                        $posts[] = []; // 아래에서 새 게시글을 맨 앞에 추가합니다.
                        array_pop($posts);

                        array_unshift($posts, [
                            'id' => $id,
                            'name' => $isAdmin ? '관리자' : $name,
                            'is_admin' => $isAdmin,
                            'title' => $title,
                            'content' => $content,
                            'password_hash' => $isAdmin ? '' : password_hash($pw, PASSWORD_DEFAULT),
                            'date' => date('Y-m-d H:i'),
                            'views' => 0,
                            'comments' => []
                        ]);
                        savePosts($dataFile, $posts);
                        $redirectId = $id;
                    }
                } elseif ($action === 'comment') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $name = trim((string)($_POST['name'] ?? ''));
                    $content = trim((string)($_POST['content'] ?? ''));
                    $pw = (string)($_POST['password'] ?? '');

                    if ($content === '') {
                        $message = '댓글 내용을 입력해 주세요.';
                    } elseif (charCount($content) > 1000) {
                        $message = '댓글은 1000자 이내로 작성해 주세요.';
                    } elseif (!$isAdmin && ($name === '' || $pw === '')) {
                        $message = '닉네임과 댓글 삭제 비밀번호를 입력해 주세요.';
                    } elseif ((!$isAdmin && charCount($name) > 20) || strlen($pw) > 200) {
                        $message = '입력한 내용이 허용 길이를 초과했습니다.';
                    } else {
                        $found = false;
                        foreach ($posts as &$post) {
                            if (($post['id'] ?? '') !== $postId) continue;
                            $found = true;
                            if (!isset($post['comments']) || !is_array($post['comments'])) {
                                $post['comments'] = [];
                            }
                            $post['comments'][] = [
                                'id' => bin2hex(random_bytes(8)),
                                'name' => $isAdmin ? '관리자' : $name,
                                'is_admin' => $isAdmin,
                                'content' => $content,
                                'password_hash' => $isAdmin ? '' : password_hash($pw, PASSWORD_DEFAULT),
                                'date' => date('Y-m-d H:i')
                            ];
                            break;
                        }
                        unset($post);

                        if ($found) {
                            savePosts($dataFile, $posts);
                            $redirectId = $postId;
                        } else {
                            $message = '게시글을 찾을 수 없습니다.';
                        }
                    }
                } elseif ($action === 'delete_post') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $pw = (string)($_POST['password'] ?? '');
                    $found = false;

                    foreach ($posts as $i => $post) {
                        if (($post['id'] ?? '') !== $postId) continue;
                        $found = true;
                        $isOwner = !empty($post['password_hash'])
                            && password_verify($pw, $post['password_hash']);
                        $isMaster = hash_equals((string)BOARD_MASTER_PASSWORD, $pw);

                        if ($isAdmin || $isOwner || $isMaster) {
                            array_splice($posts, $i, 1);
                            savePosts($dataFile, $posts);
                            $redirectId = '';
                        } else {
                            $message = '삭제 권한이 없거나 비밀번호가 올바르지 않습니다.';
                            $redirectId = $postId;
                        }
                        break;
                    }
                    if (!$found) $message = '게시글을 찾을 수 없습니다.';
                } elseif ($action === 'delete_comment') {
                    $postId = (string)($_POST['post_id'] ?? '');
                    $commentId = (string)($_POST['comment_id'] ?? '');
                    $pw = (string)($_POST['password'] ?? '');
                    $foundPost = false;
                    $foundComment = false;

                    foreach ($posts as &$post) {
                        if (($post['id'] ?? '') !== $postId) continue;
                        $foundPost = true;
                        $comments = $post['comments'] ?? [];
                        foreach ($comments as $i => $comment) {
                            if (($comment['id'] ?? '') !== $commentId) continue;
                            $foundComment = true;
                            $isOwner = !empty($comment['password_hash'])
                                && password_verify($pw, $comment['password_hash']);
                            $isMaster = hash_equals((string)BOARD_MASTER_PASSWORD, $pw);

                            if ($isAdmin || $isOwner || $isMaster) {
                                array_splice($comments, $i, 1);
                                $post['comments'] = $comments;
                            } else {
                                $message = '삭제 권한이 없거나 비밀번호가 올바르지 않습니다.';
                            }
                            break;
                        }
                        break;
                    }
                    unset($post);

                    if ($foundPost && $foundComment && $message === '') {
                        savePosts($dataFile, $posts);
                    } elseif (!$foundPost || !$foundComment) {
                        $message = '게시글 또는 댓글을 찾을 수 없습니다.';
                    }
                    $redirectId = $postId;
                }

                flock($lock, LOCK_UN);
                fclose($lock);
                $lock = null;

                if ($redirectId !== '') redirectBoard($redirectId);
                if ($action === 'delete_post' && $message === '') redirectBoard();
                if ($action === 'delete_comment' && $message === '') redirectBoard($postId);
            } catch (Throwable $ex) {
                if (is_resource($lock)) {
                    @flock($lock, LOCK_UN);
                    @fclose($lock);
                }
                error_log('Board error: ' . $ex->getMessage());
                $message = '처리 중 오류가 발생했습니다. 서버 로그와 권한을 확인해 주세요.';
            }
        }
    }
}

$posts = loadPosts($dataFile);
$id = (string)($_GET['id'] ?? '');
$selected = null;

if ($id !== '') {
    foreach ($posts as &$post) {
        if (($post['id'] ?? '') !== $id) continue;
        $selected = $post;

        if (empty($_SESSION['board_viewed'][$id])) {
            $viewLock = @fopen($lockFile, 'c');
            if ($viewLock) {
                flock($viewLock, LOCK_EX);
                $latest = loadPosts($dataFile);
                foreach ($latest as &$item) {
                    if (($item['id'] ?? '') === $id) {
                        $item['views'] = (int)($item['views'] ?? 0) + 1;
                        $selected = $item;
                        break;
                    }
                }
                unset($item);
                savePosts($dataFile, $latest);
                flock($viewLock, LOCK_UN);
                fclose($viewLock);
                $_SESSION['board_viewed'][$id] = true;
                $posts = $latest;
            }
        }
        break;
    }
    unset($post);
}

function renderAuthor($name, $isAdmin) {
    if ($isAdmin) {
        echo '<span class="admin-name">👑 관리자</span>';
    } else {
        echo e($name !== '' ? $name : '익명');
    }
}
